{
  "name": "usta-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Android and iOS apps for Usta (Capacitor wrapper around ../public)",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "assets": "capacitor-assets generate --iconBackgroundColor '#0f766e' --splashBackgroundColor '#0f766e'"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "8.6.0"
  }
}
